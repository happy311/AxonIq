# syntax=docker/dockerfile:1.7
# GPU variant — host needs the NVIDIA driver + NVIDIA Container Toolkit (`docker run --gpus all`).
# Same hardening as Dockerfile: multi-stage, baked assets, non-root, read-only-rootfs friendly.
FROM python:3.11-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ git libgomp1 \
    && rm -rf /var/lib/apt/lists/*
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 TF_USE_LEGACY_KERAS=1 TF_CPP_MIN_LOG_LEVEL=2
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements-torch-gpu.txt .
RUN pip install -r requirements-torch-gpu.txt
COPY requirements.txt constraints.txt ./
RUN pip install -r requirements.txt -c constraints.txt
ENV MRI_WORK_DIR=/opt/mri_assets/work MRI_TEMPLATE_CACHE=/opt/mri_assets/templateflow \
    TEMPLATEFLOW_HOME=/opt/mri_assets/templateflow MRI_ATLAS_DATASET_DIR=/opt/mri_assets/atlases \
    HOME=/opt/mri_assets/home MRI_DEVICE=cpu
COPY api/ /src/api/
COPY scripts/bake_assets.py /src/scripts/bake_assets.py
RUN mkdir -p /opt/mri_assets/home && cd /src && python scripts/bake_assets.py \
    && rm -rf /opt/mri_assets/work && find /opt/mri_assets -type d -exec chmod 755 {} + \
    && find /opt/mri_assets -type f -exec chmod 644 {} +

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common libgomp1 \
    && add-apt-repository -y ppa:deadsnakes/ppa && apt-get update \
    && apt-get install -y --no-install-recommends python3.11 \
    && apt-get purge -y software-properties-common && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /nonexistent --shell /usr/sbin/nologin app
# NOTE: /opt/venv was built against the python:3.11-slim interpreter path; if the venv's python
# symlink breaks on this base, run `python3.11 -m venv --upgrade /opt/venv` here.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/mri_assets /opt/mri_assets
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --chown=root:root api/ ./api/
COPY --chown=root:root frontend/ ./frontend/
COPY --chown=root:root make_admin.py start.py ./
RUN mkdir -p /app/checkpoints /data/db /data/chroma /data/mri_store /backups /tmp/axoniq_mri && chown -R app:app /data /backups
ENV PORT=8000 ENV=production PYTHONPATH=/app NEUROCHECK_DB=/data/db/neurocheck.db CHROMA_DB_PATH=/data/chroma \
    BACKUP_DIR=/backups HOME=/opt/mri_assets/home TEMPLATEFLOW_HOME=/opt/mri_assets/templateflow \
    MRI_TEMPLATE_CACHE=/opt/mri_assets/templateflow MRI_ATLAS_DATASET_DIR=/opt/mri_assets/atlases \
    MRI_WORK_DIR=/tmp/axoniq_mri MRI_DEVICE=auto TF_USE_LEGACY_KERAS=1 MRI_MAX_CONCURRENT_JOBS=1 MRI_CHECKPOINT_DIR=/app/checkpoints \
    FORWARDED_ALLOW_IPS=127.0.0.1
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"
# Single worker: job state + loaded models live in one process.
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --timeout-keep-alive 1800 --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS}\""]
