# Copy this file to .env and fill in real values before starting the app.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START if this is < 32 chars or contains "CHANGE"/"example"/"placeholder".
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_RUNNING
JWT_EXPIRE_MINUTES=480          # max 1440
# Fernet key for encrypting messages + MRI findings at rest. REQUIRED in production.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS KEY UP SEPARATELY — lose it and the data is unrecoverable.
DATA_ENCRYPTION_KEY=
ENV=production                  # "dev" enables /docs and non-Secure cookies — never in production
DOMAIN=axoniq.example.org       # used by docker-compose / Traefik
ACME_EMAIL=you@example.org
PUBLIC_BASE_URL=https://axoniq.example.org   # used in e-mailed reset links
ALLOWED_ORIGINS=                # comma-separated exact origins; empty = same-origin only (no "*")
FORWARDED_ALLOW_IPS=127.0.0.1   # reverse-proxy IP/CIDR; compose overrides with its subnet
CHAT_DAILY_QUOTA=200
MRI_DAILY_UPLOAD_QUOTA=10
RETENTION_DAYS=0                # 0 = keep until the user deletes; e.g. 365 to purge idle sessions
# Pinned SHA-256 of each checkpoint:  "axial.pt:<hex>,coronal.pt:<hex>,sagittal.pt:<hex>"
# (or put "<hex>  <file>" lines in checkpoints/SHA256SUMS). The app refuses to start on mismatch.
MRI_CHECKPOINT_SHA256=

# ── LLM (Claude primary, HuggingFace fallback) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
HF_TOKEN=
HF_MODEL=

# ── Admin ─────────────────────────────────────────────────────────────────────
# The administrator account is created from these at startup (before any request is served).
# Sign in at /admin. The password must be >= 12 chars; the app refuses to start otherwise, and also
# refuses if ADMIN_USERNAME already exists as a normal (registered) account.
# Changing ADMIN_PASSWORD and restarting re-syncs the password; changing ADMIN_USERNAME demotes the old one.
# Leave ADMIN_USERNAME empty to disable this and use `python make_admin.py <username>` instead.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Doctors self-register on the sign-up page (licence number + institution) and appear under
# "Doctor Approvals" in /admin. They cannot sign in until you permit them.

# ── Stored MRI scans (encrypted at rest with DATA_ENCRYPTION_KEY; doctors download them as DICOM zips) ──
# MRI_STORE_DIR=/data/mri_store
MRI_STORE_MAX_PER_USER=20       # stored scans per patient (each can be up to MRI_MAX_UPLOAD_BYTES)

# ── Email (OTP / password reset) ──────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
# Where the SQLite DB, ChromaDB, and backups live. On a plain AWS EC2/Docker
# deployment this is just a local directory that should live on persistent
# disk (not /tmp) so data survives a container restart.
DATA_DIR=/data

# ── MRI segmentation engine (v21 — merged in-process, CPU-only) ──────────────
# Leave these at their defaults unless you know you need to change them.
MRI_DEVICE=cpu
MRI_CHECKPOINT_DIR=/app/checkpoints
MRI_MAX_CONCURRENT_JOBS=1
MRI_INFERENCE_TIMEOUT=1500
# MRI_WORK_DIR=/tmp/axoniq_mri
# MRI_ATLAS_DATASET_DIR=/app/atlases/nilearn_atlases
# DICOM-zip → NIfTI conversion sandbox (uploads of .zip)
# MRI_CONVERT_MEM_MB=4096
# MRI_CONVERT_TIMEOUT_S=180
