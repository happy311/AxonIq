# Copy this file to .env and fill in real values before starting the app.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_RUNNING

# ── LLM (Claude primary, HuggingFace fallback) ────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
HF_TOKEN=
HF_MODEL=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=

# ── Email (OTP / password reset) ──────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
# Where the SQLite DB, ChromaDB, and backups live. On a plain AWS EC2/Docker
# deployment this is just a local directory that should live on persistent
# disk (not /tmp) so data survives a container restart.
DATA_DIR=/data

# ── MRI segmentation engine (v21 — merged in-process, CPU-only) ──────────────
# Leave these at their defaults unless you know you need to change them.
MRI_DEVICE=cpu
MRI_CHECKPOINT_DIR=/app/checkpoints
MRI_MAX_CONCURRENT_JOBS=1
MRI_INFERENCE_TIMEOUT=1500
# MRI_WORK_DIR=/tmp/axoniq_mri
# MRI_ATLAS_DATASET_DIR=/app/atlases/nilearn_atlases
